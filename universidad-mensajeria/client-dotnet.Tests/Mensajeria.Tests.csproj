<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Solo tests: net10.0 es el runtime instalado; la app sigue en net8.0-windows (§7.3). -->
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>Mensajeria.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.31" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <!-- Se compilan las fuentes no-UI del cliente (sin Views/App.xaml) -->
  <ItemGroup>
    <Compile Include="..\client-dotnet\Componentes\*.cs" />
    <Compile Include="..\client-dotnet\Transversal\*.cs" />
    <Compile Include="..\client-dotnet\Store\*.cs" />
    <Compile Include="..\client-dotnet\Fachada\FachadaCliente.cs" />
    <Compile Include="..\client-dotnet\Fachada\IFachadaCliente.cs" />
  </ItemGroup>

  <!-- El DDL local tiene UNA sola copia, la de client-dotnet (MUERTE-5/PAT-06).
       Antes LocalStore llevaba una copia incrustada del schema que era la que
       ejecutaban estos tests: la app de verdad usaba el .sql y los tests usaban
       el otro, asi que podian divergir en silencio. Al enlazar el mismo
       fichero, los tests validan el esquema que se distribuye. -->
  <ItemGroup>
    <None Include="..\client-dotnet\Store\schema-local.sql" Link="Store\schema-local.sql">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- Fixture canonico de client.properties: lo leen los tests de los TRES
       clientes para demostrar que el mismo fichero da los mismos valores. -->
  <ItemGroup>
    <None Include="..\common-protocol\test-fixtures\client-properties-fixture.properties"
          Link="client-properties-fixture.properties">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
