# Plantilla de secretos de produccion (DIST-01 / SEG-03).
# Copiar a `.env.prod` (gitignorado) y fijar valores reales. NO versionar el .env.prod.
# El servidor con MENSAJERIA_PROD=true no arranca si queda algun default de ejemplo.
MENSAJERIA_PROD=true
DB_MYSQL_PASS=CAMBIAR-ESTA-CLAVE-MYSQL
# Solo si red.tls.habilitado=true (keystore PKCS12 en ./config):
RED_TLS_CLAVE=CAMBIAR-ESTA-CLAVE-TLS
