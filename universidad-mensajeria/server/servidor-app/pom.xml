<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>universidad.mensajeria</groupId>
        <artifactId>mensajeria-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>servidor-app</artifactId>
    <name>Servidor App</name>
    <description>Ensamblado: inicio, vistas, fachada, nucleo, persistencia (compila solo contra int-*, PLAN2 §2.4)</description>

    <properties>
        <javafx.version>21.0.6</javafx.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.jline</groupId>
            <artifactId>jline-reader</artifactId>
            <version>3.30.17</version>
        </dependency>
        <dependency>
            <groupId>org.jline</groupId>
            <artifactId>jline-terminal-jansi</artifactId>
            <version>3.30.17</version>
        </dependency>
        <dependency>
            <groupId>universidad.mensajeria</groupId>
            <artifactId>dto</artifactId>
        </dependency>
        <dependency>
            <groupId>universidad.mensajeria</groupId>
            <artifactId>utilerias</artifactId>
        </dependency>
        <dependency>
            <groupId>universidad.mensajeria</groupId>
            <artifactId>int-protocolo-comunicacion</artifactId>
        </dependency>
        <dependency>
            <groupId>universidad.mensajeria</groupId>
            <artifactId>int-cliente-servidor</artifactId>
        </dependency>
        <dependency>
            <groupId>universidad.mensajeria</groupId>
            <artifactId>int-servicios-disponibles</artifactId>
        </dependency>
        <dependency>
            <groupId>universidad.mensajeria</groupId>
            <artifactId>int-usuarios-disponibles</artifactId>
        </dependency>
        <dependency>
            <groupId>universidad.mensajeria</groupId>
            <artifactId>int-gestor-mensajes</artifactId>
        </dependency>
        <!-- comp-* SOLO en runtime: servidor-app compila unicamente contra int-* (§2.4) -->
        <dependency>
            <groupId>universidad.mensajeria</groupId>
            <artifactId>comp-protocolo-comunicacion</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>universidad.mensajeria</groupId>
            <artifactId>comp-protocolo-clienteservidor</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>universidad.mensajeria</groupId>
            <artifactId>comp-servicios</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>universidad.mensajeria</groupId>
            <artifactId>comp-usuarios</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>universidad.mensajeria</groupId>
            <artifactId>comp-gestor-colas</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
        </dependency>
        <!-- codec llega en compile via comp-protocolo-comunicacion (tests E2E lo usan) -->

        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
        </dependency>

        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>com.oracle.database.jdbc</groupId>
            <artifactId>ojdbc11</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-mysql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-oracle</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <archive>
                        <manifestEntries>
                            <!-- Java 22+: acceso nativo sin flag en la linea de comandos.
                                 spring-boot:repackage conserva el manifest. -->
                            <Enable-Native-Access>ALL-UNNAMED</Enable-Native-Access>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>${spring-boot.version}</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
