<!-- Tests: solo consola, sin fichero (cero residuos en server/logs).
     Spring Boot prefiere logback-test.xml sobre application.properties,
     asi que logging.file.name queda sin efecto aqui. Produccion intacta. -->
<configuration>
  <appender name="CONSOLA" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>%d{yyyy-MM-dd HH:mm:ss} [%thread] %-5level %logger{36} - %msg%n</pattern>
    </encoder>
  </appender>
  <root level="INFO">
    <appender-ref ref="CONSOLA" />
  </root>
</configuration>
