<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Tema oscuro Telegram liso (UI-09). Mismas claves que TemaClaro.xaml. -->
    <SolidColorBrush x:Key="CardBrush" Color="#FF182533" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="#FF2A3B4D" />
    <SolidColorBrush x:Key="HeaderBrush" Color="#FF1F3A5F" />
    <SolidColorBrush x:Key="TitleBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="SubtitleBrush" Color="#FFC9D6E8" />
    <SolidColorBrush x:Key="EyebrowBrush" Color="#FF9FB6D8" />
    <SolidColorBrush x:Key="LabelBrush" Color="#FFE8EEF2" />
    <SolidColorBrush x:Key="MutedBrush" Color="#FFA8B8C1" />
    <SolidColorBrush x:Key="ChatBgBrush" Color="#FF0E1621" />
    <SolidColorBrush x:Key="WindowBgBrush" Color="#FF0E1621" />
    <SolidColorBrush x:Key="BubbleOwnBrush" Color="#FF7B61B8" />
    <SolidColorBrush x:Key="BubbleInBrush" Color="#FF182533" />
    <SolidColorBrush x:Key="BubbleBorderBrush" Color="#FF2A3B4D" />
    <SolidColorBrush x:Key="BubbleOwnFgBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="BubbleInFgBrush" Color="#FFE8EEF2" />
    <SolidColorBrush x:Key="RemitenteBrush" Color="#FFC4B5FD" />
    <SolidColorBrush x:Key="FechaBrush" Color="#FFC4B5FD" />
    <SolidColorBrush x:Key="VistoLeidoBrush" Color="#FF5EB1FF" />
    <!-- UIX-18: el tick no-leido era #FFE8EEF2, el mismo gris del cuerpo:
         se confunde con el texto. Gris medio propio, distinto del cuerpo
         (#FFFFFFFF/#FFE8EEF2) y del leido azul (#FF5EB1FF). -->
    <SolidColorBrush x:Key="VistoOtroBrush" Color="#FFA8B8C1" />
    <SolidColorBrush x:Key="CitaBgBrush" Color="#FF243447" />
    <SolidColorBrush x:Key="CitaBorderBrush" Color="#FFA78BFA" />
    <SolidColorBrush x:Key="CitaTextBrush" Color="#FFC4B5FD" />
</ResourceDictionary>
