<Window x:Class="Mensajeria.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Mensajería Académica | Iniciar sesión" MinHeight="560" MinWidth="440"
        SizeToContent="WidthAndHeight" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBgBrush}">
    <Border Margin="24" Background="{DynamicResource CardBrush}" CornerRadius="12" Padding="0"
            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
        <StackPanel>
            <Border Background="{DynamicResource HeaderBrush}" CornerRadius="12,12,0,0" Padding="18,14">
                <StackPanel>
                    <TextBlock Text="UNIVERSIDAD" Foreground="{DynamicResource EyebrowBrush}" FontSize="11" FontWeight="Bold"/>
                    <TextBlock Text="Mensajería Académica" Foreground="{DynamicResource TitleBrush}" FontSize="20" FontWeight="Bold"/>
                    <TextBlock Text="Iniciar sesión"
                               Foreground="{DynamicResource SubtitleBrush}" FontSize="12" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
            <StackPanel Margin="28,18,28,24">
                <TextBlock Text="Código universitario" FontWeight="SemiBold" Margin="0,0,0,5"
                           Foreground="{DynamicResource LabelBrush}"/>
                <ui:TextBox x:Name="txtCodigo" PlaceholderText="A001234567" ClearButtonEnabled="True" Margin="0,0,0,12"/>

                <TextBlock Text="Contraseña" FontWeight="SemiBold" Margin="0,0,0,5"
                           Foreground="{DynamicResource LabelBrush}"/>
                <ui:PasswordBox x:Name="txtContrasena" PlaceholderText="••••••••••" Margin="0,0,0,12"/>

                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="Servidor" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,5"/>
                        <ui:TextBox x:Name="txtHost" PlaceholderText="localhost" IsEnabled="False"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Puerto" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,5"/>
                        <ui:TextBox x:Name="txtPuerto" PlaceholderText="5000" IsEnabled="False"/>
                    </StackPanel>
                </Grid>
                <TextBlock Text="Tema" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,5"/>
                <ComboBox x:Name="cmbTema" Margin="0,0,0,8" SelectionChanged="CmbTema_SelectionChanged">
                    <ComboBoxItem Content="Oscuro"/>
                    <ComboBoxItem Content="Claro"/>
                </ComboBox>
                <ui:Button x:Name="btnEntrar" Content="Iniciar sesión →" Appearance="Primary"
                           Click="BtnEntrar_Click" MinHeight="40" HorizontalAlignment="Stretch"
                           HorizontalContentAlignment="Center" IsDefault="True"/>
                <!-- Fase 10.2 (P2): sin «Crear cuenta»: el alta es solo por archivo plano (CSV). -->

                <!-- UIX-00f: "Conectando…" es un estado de carga, no un error. Antes
                     se escribia en txtError y se hacia visible bordeError, que es
                     rojo (#FDECEA / #B91C1C): pareceria una caída. Ahora el aviso de
                     carga tiene su propia etiqueta en gris neutro. -->
                <TextBlock x:Name="txtCargando" Foreground="{DynamicResource MutedBrush}"
                           FontSize="11" Margin="0,10,0,0" TextWrapping="Wrap"
                           Visibility="Collapsed"/>

                <Border x:Name="bordeError" Background="#FDECEA" BorderBrush="#F1A9A5" BorderThickness="1"
                        CornerRadius="8" Padding="9" Margin="0,12,0,0" Visibility="Collapsed">
                    <TextBlock x:Name="txtError" Foreground="#B91C1C" TextWrapping="Wrap"/>
                </Border>
                <Border x:Name="bordeAviso" Background="#FFFBEB" BorderBrush="#F2CE84" BorderThickness="1"
                        CornerRadius="8" Padding="9" Margin="0,8,0,0" Visibility="Collapsed">
                    <TextBlock x:Name="txtAviso" Foreground="#B45309" TextWrapping="Wrap"/>
                </Border>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
