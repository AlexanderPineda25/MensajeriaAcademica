<Window x:Class="Mensajeria.Views.ChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:Mensajeria.Views"
        Title="Mensajería Académica | Chat" Height="760" Width="1120"
        MinHeight="600" MinWidth="880" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBgBrush}">
    <Window.Resources>
        <local:AnchoBurbujaConverter x:Key="AnchoBurbuja"/>
    </Window.Resources>
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <!-- UIX-11: sidebar redimensionable (ancho persistido en client.properties). -->
            <ColumnDefinition x:Name="colSidebar" Width="300" MinWidth="250" MaxWidth="360"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                      ShowsPreview="True" DragCompleted="Splitter_DragCompleted"/>
            <Border Grid.Column="0" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1,1,0,1">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="16,16,16,12">
                    <TextBlock Text="Mensajería" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource LabelBrush}"/>
                    <TextBlock x:Name="txtSesion" Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,12"/>
                    <ui:TextBox x:Name="txtBuscar" PlaceholderText="Buscar nombre o código"
                                TextChanged="TxtBuscar_TextChanged" Margin="0,0,0,8"/>
                    <ComboBox x:Name="cmbFiltro" Margin="0,0,0,8" SelectionChanged="CmbFiltro_SelectionChanged">
                        <ComboBoxItem Content="Todos" IsSelected="True"/>
                        <ComboBoxItem Content="Conectados"/>
                        <ComboBoxItem Content="Con no leídos"/>
                    </ComboBox>
                    <DockPanel>
                        <TextBlock Text="Contactos" FontWeight="SemiBold" Foreground="{DynamicResource LabelBrush}" VerticalAlignment="Center"/>
                        <ui:Button DockPanel.Dock="Right" Content="Actualizar" Click="BtnActualizar_Click"/>
                    </DockPanel>
                </StackPanel>
                <Border x:Name="bannerOffline" DockPanel.Dock="Top" Background="#FFFBEB" BorderBrush="#F2CE84" BorderThickness="1"
                        CornerRadius="8" Padding="9" Margin="8,0,8,0" Visibility="Collapsed">
                    <TextBlock x:Name="bannerOfflineText" Text="⛔ Sin conexión — mensajes en cola local, se reintentan solos"
                               Foreground="#B45309" FontWeight="SemiBold" FontSize="11" TextWrapping="Wrap"/>
                </Border>
                <StackPanel DockPanel.Dock="Bottom" Margin="8,0,8,10">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <ui:Button Content="KICK otras" Click="BtnKickOtras_Click"
                                   AutomationProperties.Name="Cerrar otras sesiones" Margin="0,0,6,0"/>
                        <ui:Button Content="Salir" Click="BtnSalir_Click" Margin="0,0,6,0"/>
                        <ui:Button Content="Salir en todos" Click="BtnSalirTodos_Click"/>
                    </StackPanel>
                    <ComboBox x:Name="cmbTema" SelectionChanged="CmbTema_SelectionChanged">
                        <ComboBoxItem Content="Oscuro"/>
                        <ComboBoxItem Content="Claro"/>
                    </ComboBox>
                </StackPanel>
                <ListView x:Name="lstUsuarios" Margin="8,0,8,10" BorderThickness="0" Background="{DynamicResource CardBrush}"
                          SelectionChanged="LstUsuarios_SelectionChanged">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="4,7">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Ellipse Grid.Column="0" Width="7" Height="7" VerticalAlignment="Center"
                                         Fill="{Binding ColorPresencia}"/>
                                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                    <DockPanel LastChildFill="False">
                                        <TextBlock Text="{Binding Etiqueta}" FontWeight="SemiBold" Foreground="{DynamicResource LabelBrush}" TextTrimming="CharacterEllipsis"/>
                                        <!-- UIX-02: distintivo de no leídos. -->
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding TextoInsignia}" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource RemitenteBrush}" Margin="8,0,0,0"
                                                   Visibility="{Binding MostrarInsignia}"/>
                                    </DockPanel>
                                    <TextBlock Text="{Binding Presencia}" FontSize="11" Foreground="{DynamicResource MutedBrush}"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </DockPanel>
        </Border>
        <DockPanel Grid.Column="2" Margin="0,0,0,0" Background="{DynamicResource ChatBgBrush}">
            <Border DockPanel.Dock="Top" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1,1,1,0" Padding="18,12">
                <DockPanel>
                    <StackPanel>
                        <TextBlock x:Name="txtTitulo" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource LabelBrush}" Text="Selecciona una conversación"/>
                        <TextBlock x:Name="txtEstado" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,3,0,0"/>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:Button x:Name="btnAnteriores" Content="↑ Cargar mensajes anteriores"
                                   Click="BtnAnteriores_Click" Visibility="Collapsed"
                                   AutomationProperties.Name="Cargar mensajes anteriores"/>
                        <!-- UIX-14: gira mientras se trae historial. -->
                        <ProgressBar x:Name="barraProgreso" Width="90" Height="12" Margin="8,0,0,0"
                                     IsIndeterminate="True" Visibility="Collapsed"
                                     VerticalAlignment="Center"/>
                        <!-- UIX-16: baja a lo nuevo sin perder el punto de lectura. -->
                        <ui:Button x:Name="btnNuevos" Content="↓ Nuevos" Click="BtnNuevos_Click"
                                   Visibility="Collapsed" Margin="8,0,0,0"
                                   AutomationProperties.Name="Ir a mensajes nuevos"/>
                    </StackPanel>
                </DockPanel>
            </Border>
            <Border x:Name="bordeAvisoInline" DockPanel.Dock="Top" BorderThickness="1" CornerRadius="7"
                    Padding="10,8" Margin="12,8,12,0" Visibility="Collapsed"
                    AutomationProperties.LiveSetting="Polite">
                <DockPanel LastChildFill="True">
                    <Button DockPanel.Dock="Right" Content="✕" Click="BtnCerrarAvisoInline_Click"
                            AutomationProperties.Name="Cerrar aviso" ToolTip="Cerrar aviso"
                            Padding="6,1" Margin="12,0,0,0" VerticalAlignment="Top"/>
                    <StackPanel>
                        <TextBlock x:Name="txtTituloAvisoInline" FontWeight="SemiBold"/>
                        <TextBlock x:Name="txtAvisoInline" TextWrapping="Wrap" Margin="0,2,0,0"/>
                    </StackPanel>
                </DockPanel>
            </Border>
            <!-- UIX-06: buscar en el historial (Ctrl+F). Oculta hasta invocarla. -->
            <Border x:Name="barraBuscar" DockPanel.Dock="Top" Background="{DynamicResource CardBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1,1,1,0" Padding="18,6"
                    Visibility="Collapsed">
                <DockPanel LastChildFill="True">
                    <ui:TextBox x:Name="txtBuscarHistorial" MinWidth="200"
                                PlaceholderText="Buscar en el historial"
                                TextChanged="TxtBuscarHistorial_TextChanged"
                                KeyDown="TxtBuscarHistorial_KeyDown"/>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:Button Content="↑" Click="BtnBuscarAnterior_Click" AutomationProperties.Name="Anterior coincidencia" ToolTipService.ToolTip="Anterior (Mayús+Enter)" Margin="8,0,0,0"/>
                        <ui:Button Content="↓" Click="BtnBuscarSiguiente_Click" AutomationProperties.Name="Siguiente coincidencia" ToolTipService.ToolTip="Siguiente (Enter)" Margin="4,0,0,0"/>
                        <TextBlock x:Name="txtBuscarContador" Foreground="{DynamicResource MutedBrush}" FontSize="11"
                                   VerticalAlignment="Center" Margin="8,0,0,0"/>
                        <ui:Button Content="✕" Click="BtnBuscarCerrar_Click" AutomationProperties.Name="Cerrar búsqueda" ToolTipService.ToolTip="Cerrar (Esc)" Margin="4,0,0,0"/>
                    </StackPanel>
                </DockPanel>
            </Border>
            <StackPanel DockPanel.Dock="Bottom" Background="{DynamicResource CardBrush}" Margin="0"
                        AllowDrop="True" Drop="ZonaEnvio_Drop" DragOver="ZonaEnvio_DragOver">
                <Border x:Name="bordeRespuesta" Visibility="Collapsed" Background="{DynamicResource CitaBgBrush}"
                        BorderBrush="{DynamicResource CitaBorderBrush}" BorderThickness="3,1,1,1" CornerRadius="6"
                        Margin="16,10,16,0" Padding="8,4">
                    <DockPanel LastChildFill="True">
                        <Button Content="✕" DockPanel.Dock="Right"
                                 Click="BtnQuitarRespuesta_Click" AutomationProperties.Name="Cancelar respuesta" Padding="6,1" Margin="8,0,0,0"
                                 VerticalAlignment="Center"/>
                        <TextBlock x:Name="txtRespuesta" Foreground="{DynamicResource CitaTextBrush}"
                                   TextTrimming="CharacterEllipsis" TextWrapping="Wrap"
                                   VerticalAlignment="Center"/>
                    </DockPanel>
                </Border>
                <TextBlock x:Name="txtImagenAdjunta" Foreground="{DynamicResource LabelBrush}" Margin="16,8,16,0" Text=""/>
                <StackPanel x:Name="panelArchivo" Orientation="Horizontal" Margin="16,6,16,0" Visibility="Collapsed">
                    <TextBlock x:Name="txtArchivoAdjunto" Foreground="{DynamicResource LabelBrush}" VerticalAlignment="Center" Text=""/>
                    <ui:Button Content="Quitar" Click="BtnQuitarArchivo_Click"
                               VerticalAlignment="Center" Margin="8,0,0,0"/>
                </StackPanel>
                <StackPanel x:Name="panelPreview" Orientation="Horizontal" Margin="16,6,16,0" Visibility="Collapsed">
                    <Border BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" Padding="4">
                        <Image x:Name="imgPreview" MaxHeight="90" MaxWidth="140" Stretch="Uniform"/>
                    </Border>
                    <ui:Button Content="Quitar" Click="BtnQuitarImagen_Click"
                               VerticalAlignment="Center" Margin="8,0,0,0"/>
                </StackPanel>
                <Grid Margin="14,10,14,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ui:Button Grid.Column="0" Content="＋" Click="BtnAdjuntar_Click" AutomationProperties.Name="Adjuntar imagen" Margin="0,0,8,0" MinWidth="44" ToolTipService.ToolTip="Adjuntar archivo (Todos *.*)"/>
<ui:TextBox x:Name="txtMensaje" Grid.Column="1" MinHeight="42" TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 TextChanged="TxtMensaje_TextChanged" KeyDown="TxtMensaje_KeyDown"
                                 PlaceholderText="Escribe un mensaje (Enter para enviar, Mayús+Enter para salto)" Margin="0,0,8,0"/>
                    <ui:Button x:Name="btnEnviar" Grid.Column="2" Content="Enviar" Appearance="Primary" Click="BtnEnviar_Click" MinWidth="82"/>
                </Grid>
            </StackPanel>
            <Grid x:Name="panelMensajes" Background="{DynamicResource ChatBgBrush}">
                <ListBox x:Name="lstMensajes" Background="Transparent" BorderThickness="0"
                     HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     VirtualizingPanel.ScrollUnit="Pixel"
                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                     AllowDrop="True" Drop="ZonaEnvio_Drop" DragOver="ZonaEnvio_DragOver"
                     MouseDoubleClick="LstMensajes_DoubleClick"
                     ToolTipService.ToolTip="Doble-click en un mensaje para responder · Arrastra aquí imágenes o archivos para adjuntar">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="0"/>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <!-- UIX-04: cabecera de día entre mensajes de días distintos. -->
                            <TextBlock Text="{Binding TextoCabecera}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource MutedBrush}" FontSize="11"
                                       HorizontalAlignment="Center" Margin="0,8,0,4"
                                       Visibility="{Binding MostrarCabecera}"/>
                            <Border Background="{Binding Fondo}" BorderBrush="{DynamicResource BubbleBorderBrush}" BorderThickness="1" Padding="12" Margin="6,5" HorizontalAlignment="{Binding Alineacion}"
                                    MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ListBox}}, Converter={StaticResource AnchoBurbuja}}"
                                    Visibility="{Binding MostrarBurbuja}">
                            <StackPanel>
                                <DockPanel LastChildFill="False">
                                    <TextBlock Text="{Binding Encabezado}" FontWeight="SemiBold" Foreground="{DynamicResource RemitenteBrush}"
                                               Visibility="{Binding MostrarEncabezado}"/>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Estado}" Foreground="{Binding ColorEstado}" FontSize="11" Margin="16,0,0,0"/>
                                </DockPanel>
                                <local:ResaltadoTextBlock Texto="{Binding Contenido}" Patron="{Binding PatronResaltado}"
                                                   TextWrapping="Wrap" Margin="0,7,0,0" Foreground="{Binding ColorContenido}"
                                                   Visibility="{Binding MostrarTexto}"/>
                                <Image Source="{Binding Imagen}" MaxHeight="260" MaxWidth="420" Stretch="Uniform"
                                       HorizontalAlignment="Left" Margin="0,8,0,0" Cursor="Hand"
                                       ToolTipService.ToolTip="Click para ampliar · doble-click para responder"
                                       Visibility="{Binding MostrarImagen}" Loaded="MessageImage_Loaded"
                                       PreviewMouseLeftButtonUp="MessageImage_Click"/>
                                <TextBlock Text="{Binding LeyendaEtapasFiltrado}"
                                           Foreground="{DynamicResource MutedBrush}" FontSize="10"
                                           TextWrapping="Wrap" Margin="0,3,0,0"
                                           Visibility="{Binding MostrarEtapasFiltrado}"/>
                                <TextBlock Text="{Binding EstadoImagen}" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,4,0,0"
                                           Visibility="{Binding MostrarImagen}"/>
                                <Button Content="Reintentar imagen" HorizontalAlignment="Left" Margin="0,3,0,0"
                                         Visibility="{Binding MostrarReintento}" Click="BtnReintentarImagen_Click"/>
                                <Button Content="Cancelar" HorizontalAlignment="Left" Margin="0,3,0,0"
                                         Visibility="{Binding MostrarCancelar}" Click="BtnCancelarImagen_Click"/>
                                <Button Content="⬇ Descargar" HorizontalAlignment="Left" Margin="0,3,0,0"
                                         Visibility="{Binding MostrarDescarga}" Click="BtnDescargarArchivo_Click"/>
                                <DockPanel LastChildFill="False" Margin="0,8,0,0">
                                    <TextBlock Text="{Binding Fecha}" Foreground="{DynamicResource FechaBrush}" FontSize="11"
                                               VerticalAlignment="Center"/>
                                    <Button Content="Responder" DockPanel.Dock="Right" Margin="8,0,0,0"
                                         Padding="4,1" Click="BtnResponder_Click"/>
                                </DockPanel>
                            </StackPanel>
                        </Border>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
                <!-- UIX-13: estados vacíos en vez de rectángulo negro. -->
                <TextBlock x:Name="txtVacioChat" Foreground="{DynamicResource MutedBrush}" FontSize="12"
                           HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap"
                           TextAlignment="Center" Margin="24" Visibility="Collapsed"
                           Text="Elige un contacto para empezar a conversar."/>
            </Grid>
        </DockPanel>
    </Grid>
</Window>
