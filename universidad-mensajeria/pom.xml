<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>universidad.mensajeria</groupId>
    <artifactId>mensajeria-parent</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>Mensajeria Academica</name>
    <description>Sistema cliente-servidor de mensajeria para la comunidad academica (Fase 0)</description>

    <modules>
        <module>common-protocol</module>
        <module>server</module>
        <module>client</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <spring-boot.version>3.5.7</spring-boot.version>
        <!-- Flyway 11.x: la serie 10.x no conoce MySQL 8.4 (solo aviso,
             pero se fija serie que sí lo soporta). -->
        <flyway.version>11.14.1</flyway.version>
        <gson.version>2.11.0</gson.version>
        <maven.compiler.release>${java.version}</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>universidad.mensajeria</groupId>
                <artifactId>dto</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>universidad.mensajeria</groupId>
                <artifactId>codec</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>universidad.mensajeria</groupId>
                <artifactId>utilerias</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>universidad.mensajeria</groupId>
                <artifactId>int-protocolo-comunicacion</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>universidad.mensajeria</groupId>
                <artifactId>int-cliente-servidor</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>universidad.mensajeria</groupId>
                <artifactId>int-servicios-disponibles</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>universidad.mensajeria</groupId>
                <artifactId>int-usuarios-disponibles</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>universidad.mensajeria</groupId>
                <artifactId>int-gestor-mensajes</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>universidad.mensajeria</groupId>
                <artifactId>comp-protocolo-comunicacion</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>universidad.mensajeria</groupId>
                <artifactId>comp-protocolo-clienteservidor</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>universidad.mensajeria</groupId>
                <artifactId>comp-servicios</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>universidad.mensajeria</groupId>
                <artifactId>comp-usuarios</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>universidad.mensajeria</groupId>
                <artifactId>comp-gestor-colas</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>universidad.mensajeria</groupId>
                <artifactId>client-interfaces</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.google.code.gson</groupId>
                <artifactId>gson</artifactId>
                <version>${gson.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.13.0</version>
                    <configuration>
                        <release>${java.version}</release>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.5.2</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>3.4.2</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
