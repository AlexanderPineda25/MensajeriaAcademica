/* GENERADO por contrato/generar_tokens.py desde contrato/tokens-diseno.json.
 * NO editar a mano: el cambio se hace en el JSON y se regenera.
 * Plantilla comun a los dos temas.
 * Tema: {{tema}} */

.root {
    -fx-font-family: {{comunes.fuente}};
    -fx-font-size: {{comunes.tamano_fuente}};
    -fx-background-color: {{root.bg}};
}

.login-scroll { -fx-background-color: {{root.bg}}; }
.login-scroll > .viewport { -fx-background-color: transparent; }

.login-shell {
    -fx-background-color: transparent;
    -fx-padding: 28px;
}

.login-card {
    -fx-background-color: {{login.card.bg}};
    -fx-background-radius: {{comunes.radio_tarjeta}};
    -fx-border-color: {{login.card.border}};
    -fx-border-width: 1px;
    -fx-border-radius: {{comunes.radio_tarjeta}};
    -fx-effect: dropshadow(gaussian, {{login.card.shadow}}, 12, 0.15, 0, 2);
    -fx-padding: 26px 28px;
    -fx-spacing: 10px;
}

.login-header {
    -fx-background-color: {{login.header.bg}};
    -fx-background-radius: 12px 12px 0 0;
    -fx-padding: 14px 18px;
}

.login-title {
    -fx-font-size: 18px;
    -fx-font-weight: 700;
    -fx-text-fill: {{login.title.fg}};
}

.login-subtitle {
    -fx-font-size: 11.5px;
    -fx-text-fill: {{login.subtitle.fg}};
}

.login-eyebrow {
    -fx-font-size: 10.5px;
    -fx-font-weight: 700;
    -fx-text-fill: {{login.eyebrow.fg}};
}

.login-field-label {
    -fx-font-weight: bold;
    -fx-font-size: 12px;
    -fx-text-fill: {{login.label.fg}};
}

.login-field {
    -fx-background-color: {{login.field.bg}};
    -fx-background-radius: 8px;
    -fx-border-color: {{login.field.border}};
    -fx-border-radius: 8px;
    -fx-padding: 9px 10px;
    -fx-text-fill: {{login.field.fg}};
    -fx-prompt-text-fill: {{login.field.prompt}};
}

.login-field:focused {
    -fx-background-color: {{login.field.focus.bg}};
    -fx-border-color: {{login.field.focus.border}};
}

.server-chip {
    -fx-background-color: {{login.field.bg}};
    -fx-background-radius: 999px;
    -fx-border-color: {{login.chip.border}};
    -fx-border-radius: 999px;
    -fx-padding: 8px 12px;
    -fx-min-height: 38px;
}

.server-dot {
    -fx-fill: {{login.dot}};
}

.server-chip-value {
    -fx-text-fill: {{login.chip.fg}};
}

.password-row { -fx-alignment: center-left; }

.password-toggle {
    -fx-background-color: {{login.field.bg}};
    -fx-background-radius: 8px;
    -fx-border-color: {{login.field.border}};
    -fx-border-radius: 8px;
    -fx-text-fill: {{login.field.fg}};
    -fx-font-size: 15px;
    -fx-min-width: 40px;
    -fx-min-height: 36px;
    -fx-cursor: hand;
}
.password-toggle:hover { -fx-background-color: {{login.toggle.hover.bg}}; }

.login-button {
    -fx-background-color: {{login.button.bg}};
    -fx-background-radius: 8px;
    -fx-text-fill: {{comunes.boton_fg}};
    -fx-font-weight: 700;
    -fx-font-size: 14px;
    -fx-padding: 11px 18px;
    -fx-cursor: hand;
}

.login-button:hover { -fx-background-color: {{login.button.hover.bg}}; }
.login-button:disabled { -fx-opacity: 0.55; }

.login-error {
    -fx-background-color: {{comunes.error_bg}};
    -fx-border-color: {{comunes.error_border}};
    -fx-border-radius: 8px;
    -fx-background-radius: 8px;
    -fx-text-fill: {{comunes.error_fg}};
    -fx-padding: 9px 12px;
}

.login-warn {
    -fx-background-color: {{comunes.banner_offline_bg}};
    -fx-border-color: {{comunes.banner_offline_border}};
    -fx-border-radius: 8px;
    -fx-background-radius: 8px;
    -fx-text-fill: {{comunes.banner_offline_fg}};
    -fx-padding: 9px 12px;
}

.login-server {
    -fx-text-fill: {{login.server.fg}};
    -fx-font-size: 11.5px;
}

.filter-select, .combo-box {
    -fx-background-color: {{login.select.bg}};
    -fx-background-radius: 8px;
    -fx-border-color: {{login.select.border}};
    -fx-border-radius: 8px;
    -fx-text-fill: {{login.select.fg}};
    -fx-prompt-text-fill: {{login.field.prompt}};
}