    class UsuarioLocal {
        <<record · transversal>>
        +String codigo
        +String nombres
        +String apellidos
        +String programa
        +boolean conectado
        +String fechaRegistro
        +String actualizado
    }

    class MensajeLocal {
        <<record · transversal>>
        +String idMensaje
        +String origen
        +String destino
        +String tipo
        +String contenido
        +Long tamanoArchivo
        +String fechaEnvio
        +boolean enviado
        +boolean descargado
        +String estado
        +String archivoId
    }

    class PendienteEnvio {
        <<record · transversal>>
        +String id
        +String origen
        +String destino
        +byte[] payload
        +int intentos
        +String ultimoError
    }

    class RecienteChat {
        <<record · transversal>>
        +String otro
        +String ultimoContenido
        +String ultimoTipo
        +String fechaUltimo
        +int noLeidos
        +boolean conectado
    }

    class EstadoMensaje {
        <<enumeration · transversal>>
        PENDIENTE
        ERROR
        ENVIADO
        ENTREGADO
        LEIDO
        +desde(String) EstadoMensaje$
    }

    class Mensaje {
        <<record · dto>>
        +TipoMensaje tipo
        +String contenido
    }

    InterfazCacheUsuarios ..> UsuarioLocal
    InterfazHistorialLocal ..> MensajeLocal
    InterfazHistorialLocal ..> PendienteEnvio
    InterfazHistorialLocal ..> RecienteChat
    InterfazConexionRed ..> Mensaje
    InterfazConexionRed o-- ReceptorMensajes : «suscribir»
    ReceptorMensajes ..> Mensaje
    MensajeLocal ..> EstadoMensaje : «columna estado»

    note for InterfazHistorialLocal "18 métodos. Los tres últimos grupos\n(pendientes / incrementarIntento / eliminarPendiente)\nimplementan la COLA LOCAL de salida: es lo que permite\nenviar sin red y reintentar al reconectar."
    note for InterfazConexionRed "20 métodos, 8 de ellos default con sobrecarga\nde 'id'.fachadaCliente depende de esta interfaz, no al revés."
