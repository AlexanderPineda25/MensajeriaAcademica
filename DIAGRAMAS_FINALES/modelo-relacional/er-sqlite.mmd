title: "SQLite local — schema-local.sql"
---
erDiagram
    CACHE_USUARIOS {
        TEXT codigo PK "clave natural"
        TEXT nombres "NOT NULL"
        TEXT apellidos "NOT NULL"
        TEXT programa "nullable"
        INTEGER conectado "NOT NULL DEFAULT 0"
        TEXT fecha_registro "nullable"
        TEXT actualizado "NOT NULL"
    }
    HISTORIAL_LOCAL {
        TEXT id_mensaje PK "uuid del servidor"
        TEXT origen "NOT NULL, codigo emisor"
        TEXT destino "NOT NULL, codigo receptor"
        TEXT tipo "NOT NULL"
        TEXT contenido "nullable"
        TEXT hash_sha256 "nullable"
        INTEGER num_caracteres "nullable"
        INTEGER num_palabras "nullable"
        TEXT nombre_archivo "nullable"
        TEXT archivo_id "nullable, id remoto"
        TEXT ruta_archivo "nullable, copia local"
        INTEGER tamano_archivo "nullable"
        TEXT fecha_envio "NOT NULL, ISO-8601"
        INTEGER enviado "NOT NULL DEFAULT 0"
        INTEGER descargado "NOT NULL DEFAULT 0"
        TEXT estado "NOT NULL DEFAULT ENVIADO"
    }
    PENDIENTES_ENVIO {
        TEXT id PK "uuid del cliente"
        TEXT tipo "NOT NULL"
        TEXT origen "NOT NULL"
        TEXT destino "NOT NULL"
        TEXT contenido "nullable"
        TEXT nombre_archivo "nullable"
        BLOB payload "nullable, bytes si aplica"
        TEXT fecha_creado "NOT NULL"
        INTEGER intentos "NOT NULL DEFAULT 0"
        TEXT ultimo_error "nullable"
    }

    CACHE_USUARIOS ||--o{ HISTORIAL_LOCAL : "origen/destino (logica)"
    CACHE_USUARIOS ||--o{ PENDIENTES_ENVIO : "origen/destino (logica)"
